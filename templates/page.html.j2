<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ region }} {{ keyword }} 정보</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 900px; margin: 0 auto; padding: 20px; line-height: 1.6; }
    .card { border: 1px solid #ddd; border-radius: 10px; padding: 12px; margin: 10px 0; }
    .muted { color: #666; font-size: 14px; }
  </style>
</head>
<body>
  <h1>{{ region }} {{ keyword }} 정보</h1>
  <p class="muted">최종 업데이트: {{ updated_at }}</p>
  <p class="muted">※ 일부 링크는 제휴 링크일 수 있습니다.</p>

  {% for p in places %}
  <div class="card">
    <h3>{{ p.name }}</h3>
    <p>주소: {{ p.address or '-' }}</p>
    <p>전화: {{ p.phone or '-' }}</p>
    <p>출처: {{ ', '.join(p.sources) }}</p>
    {% if p.map_url %}<a href="{{ p.map_url }}" target="_blank" rel="noopener">지도 보기</a>{% endif %}
  </div>
  {% endfor %}
</body>
</html>
